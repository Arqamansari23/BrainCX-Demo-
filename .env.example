LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Gemini Live, the speech-to-speech model the voice agent runs on
GOOGLE_API_KEY=

# CRM backend (src/crm_api) and the agent's connection to it
DATABASE_URL=postgresql://crm:crm_password@localhost:5433/crm
CRM_API_URL=http://localhost:8001
# Service key the voice agent sends as X-API-Key. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_API_KEY=
# Shared password for the web app (demo only; production would use per-user accounts)
ADMIN_PASSWORD=
# Signs the session cookie. Generate like AGENT_API_KEY.
SESSION_SECRET=
ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
# IANA timezone the API and the agent use for "today" and "tomorrow". Keep it in sync with docker-compose.yml.
TIMEZONE=Asia/Karachi

# Webhooks: outbound events are signed with WEBHOOK_SECRET; inbound leads must be
# signed with INBOUND_WEBHOOK_SECRET (see scripts/send_lead.py).
# Paste a https://webhook.site URL or an n8n Webhook node URL to watch deliveries.
WEBHOOK_URL=
WEBHOOK_SECRET=
INBOUND_WEBHOOK_SECRET=
